generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PriceKind {
  BUY
  SELL
}

enum PriceSourceType {
  CATALOG
  INVOICE
  MANUAL
}

enum InvoiceStatus {
  REVIEW
  CONFIRMED
}

enum MatchConfidence {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum CatalogStatus {
  PROCESSING
  REVIEW
  APPLIED
  FAILED
}

enum CatalogLineAction {
  CREATE
  UPDATE
  SKIP
  UNCERTAIN
}

model Manufacturer {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  products  Product[]
  catalogs  CatalogImport[]
  invoices  Invoice[]
}

model Product {
  id              String         @id @default(cuid())
  manufacturerId  String
  manufacturer    Manufacturer   @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  name            String
  sku             String?
  unit            String?
  currentBuyPrice Decimal        @db.Decimal(12, 2)
  normalizedName  String
  sizeValue       Decimal?       @db.Decimal(12, 4)
  sizeUnit        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  priceHistory    PriceHistory[]
  invoiceLines    InvoiceLine[]
  catalogLines    CatalogLine[]
  extraCharges    ProductExtraCharge[]
  salesQuoteLines SalesQuoteLine[]

  @@index([manufacturerId])
  @@index([normalizedName])
  @@index([sku])
}

model PriceHistory {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind       PriceKind
  price      Decimal         @db.Decimal(12, 2)
  recordedAt DateTime        @default(now())
  sourceType PriceSourceType
  sourceId   String

  @@index([productId, kind, recordedAt(sort: Desc)])
}

model Invoice {
  id             String        @id @default(cuid())
  manufacturerId String
  manufacturer   Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  retailerName   String
  invoiceNumber  String?
  invoiceDate    DateTime?
  imagePath      String
  status         InvoiceStatus @default(REVIEW)
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          InvoiceLine[]

  @@index([manufacturerId])
}

model InvoiceLine {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  rawDescription   String
  quantity         Decimal         @db.Decimal(12, 3)
  unitPrice        Decimal         @db.Decimal(12, 2)
  lineTotal        Decimal         @db.Decimal(12, 2)
  matchConfidence  MatchConfidence @default(NONE)
  matchCandidates  Json?

  @@index([invoiceId])
  @@index([productId])
}

model CatalogImport {
  id             String            @id @default(cuid())
  manufacturerId String
  manufacturer   Manufacturer      @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  filePath       String
  status         CatalogStatus     @default(PROCESSING)
  error          String?
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lines          CatalogLine[]
  extraCharges   ExtraCharge[]
  productExtraCharges ProductExtraCharge[]

  @@index([manufacturerId])
}

model CatalogLine {
  id               String            @id @default(cuid())
  catalogImportId  String
  catalogImport    CatalogImport     @relation(fields: [catalogImportId], references: [id], onDelete: Cascade)
  rawName          String
  sku              String?
  unit             String?
  price            Decimal           @db.Decimal(12, 2)
  matchedProductId String?
  matchedProduct   Product?          @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  action           CatalogLineAction @default(CREATE)
  matchConfidence  MatchConfidence   @default(NONE)
  matchCandidates  Json?

  @@index([catalogImportId])
  @@index([matchedProductId])
}

model ExtraCharge {
  id              String        @id @default(cuid())
  catalogImportId String
  catalogImport   CatalogImport @relation(fields: [catalogImportId], references: [id], onDelete: Cascade)
  name            String
  amount          Decimal?      @db.Decimal(12, 2)
  percent         Decimal?      @db.Decimal(8, 4)

  @@index([catalogImportId])
}

model ProductExtraCharge {
  id                    String         @id @default(cuid())
  productId             String
  product               Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                  String
  amount                Decimal?       @db.Decimal(12, 2)
  percent               Decimal?       @db.Decimal(8, 4)
  sourceCatalogImportId String?
  sourceCatalogImport   CatalogImport? @relation(fields: [sourceCatalogImportId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([sourceCatalogImportId])
}

model Client {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  quotes    SalesQuote[]
}

model SalesQuote {
  id         String           @id @default(cuid())
  clientId   String
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName String
  createdBy  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  lines      SalesQuoteLine[]

  @@index([clientId, createdAt(sort: Desc)])
}

model SalesQuoteLine {
  id               String     @id @default(cuid())
  salesQuoteId     String
  salesQuote       SalesQuote @relation(fields: [salesQuoteId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  manufacturerName String
  sku              String?
  unit             String?
  quantity         Decimal    @default(1) @db.Decimal(12, 3)
  buyPrice         Decimal    @db.Decimal(12, 2)
  extraChargesTotal Decimal   @db.Decimal(12, 2)
  baseCost         Decimal    @db.Decimal(12, 2)
  marginPercent    Decimal    @db.Decimal(8, 4)
  unitQuotePrice   Decimal    @db.Decimal(12, 2)
  lineTotal        Decimal    @db.Decimal(12, 2)

  @@index([salesQuoteId])
  @@index([productId])
}
